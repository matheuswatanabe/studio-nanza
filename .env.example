# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA coloque valores reais aqui neste arquivo (.env.example é o único
# dos .env que vai pro GitHub).
#
# Onde encontrar a connection string: supabase.com -> seu projeto ->
# Project Settings -> Database -> "Connection string" -> aba "URI". Use a
# versão "Transaction pooler" (porta 6543), que funciona melhor com
# ambientes serverless como Vercel/Render/Railway. Troque SUASENHA pela
# senha do banco que você definiu ao criar o projeto — sem colchetes, sem
# espaços, só a senha mesmo.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

#NEXT_PUBLIC_SUPABASE_URL=
#NEXT_PUBLIC_SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=

# Senha única para acessar o sistema (tela de login). Escolha qualquer senha.
APP_PASSWORD=

# Integração com o Google Agenda (opcional). Sem estas duas, a agenda
# funciona normalmente, só sem o envio instantâneo para o Google.
# Onde encontrar: console.cloud.google.com -> APIs e serviços -> Credenciais
# -> seu "ID do cliente OAuth" do tipo "Aplicativo da Web".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
